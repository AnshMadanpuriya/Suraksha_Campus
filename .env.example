# GEMINI_API_KEY: Required for Gemini AI API calls in the RAG Safety Assistant.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# MONGODB_URI: Optional MongoDB connection string for external MERN deployment.
# When omitted, the server uses the built-in atomic JSON persistence store in data/campus_db.json.
MONGODB_URI=""

# PYTHON_RAG_URL: Optional standalone Python RAG microservice URL (e.g., http://localhost:8001/retrieve).
# When omitted, Express invokes python/rag_retriever.py directly via python3.
PYTHON_RAG_URL=""
